model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  // ... existing content ...

  profiles Profile[]
}

model Profile {
  id         String   @id @default(cuid())
  name       String
  description String
  user       User     @relation(fields: [id], references: [id], onDelete: Cascade)
  // ... existing content ...
}
